{
  "name": "quiz-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Private quiz API. Owns the answer key; never serves it as a static file.",
  "license": "MIT",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.js",
    "start": "node dist/src/server.js",
    "dev": "ts-node src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
