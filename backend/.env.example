# Copy to .env for local development. NEVER commit a real .env.

# development | test | production
NODE_ENV=development

PORT=3000

# EXACT origins allowed to call this API, comma separated.
# "*" is rejected. In production every entry must be https.
# Required in production; defaults to the Angular dev server otherwise.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Private quiz bank. MUST NOT sit under any statically served directory.
QUIZ_DATA_PATH=./data/quiz.json

# SQLite file for assessment sessions (used from Stage 4).
DATABASE_PATH=./data/sessions.db
